# MongoDB Atlas connection string (Atlas > Connect > Drivers). Include the database name, e.g. /greatvoyagers
MONGODB_URI=

# Long random string used to sign admin login sessions (at least 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# The single admin account. Run `npm.cmd run seed:admin` after changing these.
ADMIN_EMAIL=
ADMIN_PASSWORD=

PORT=5000

# Comma-separated frontend URLs allowed to call the API directly
CLIENT_ORIGIN=http://localhost:5173

# Number of proxies in front of the API: 1 locally or on Render alone, 2 behind Vercel's /api rewrite on Render
TRUST_PROXY=1

# Optional: Vercel deploy hook URL, so publishing a post rebuilds the prerendered blog pages and sitemap
VERCEL_DEPLOY_HOOK_URL=

# Keep-alive: on Render the API pings its own /api/health so the free plan doesn't sleep.
# It uses Render's RENDER_EXTERNAL_URL automatically; set KEEP_ALIVE_URL to override, or "off" to disable.
KEEP_ALIVE_URL=
KEEP_ALIVE_MINUTES=10
