# MongoDB Atlas connection string (Atlas > Connect > Drivers). Include the database name, e.g. /greatvoyagers
MONGODB_URI=

# Long random string used to sign admin login sessions (at least 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# The single admin account. Run `npm.cmd run seed:admin` after changing these.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Hostinger sets PORT itself. Keep 5000 for local development.
PORT=5000

# Comma-separated frontend URLs allowed to call the API (needed when the site is on www and the API is on api.)
CLIENT_ORIGIN=http://localhost:5173,https://www.greatvoyagers.com,https://greatvoyagers.com

# Hostinger sits behind one proxy
TRUST_PROXY=1
NODE_ENV=production

# Optional: Hostinger (or any) deploy webhook to rebuild prerendered blog pages after you publish a post
DEPLOY_HOOK_URL=

# Optional: folder of the Vite build if you serve the website from this same Express process
STATIC_DIR=
